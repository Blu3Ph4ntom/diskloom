import { LineEdit, ScrollView } from "std-widgets.slint";

export struct DriveItem {
    label: string,
    path: string,
}

export struct DisplayRow {
    id: int,
    name: string,
    size: string,
    allocated: string,
    kind: string,
    depth: int,
    indent_px: int,
    children: string,
    folder: bool,
    expanded: bool,
    selected: bool,
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked;

    height: 34px;
    min-width: 74px;
    border-radius: 6px;
    background: !enabled ? #25282b : checked ? #547f70 : touch.has-hover ? #34383c : #2a2d30;

    Text {
        text: root.text;
        color: root.enabled ? #edf0ef : #8a9094;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component StatLine inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 25px;
    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        width: 112px;
        height: parent.height;
        text: root.label;
        color: #8e9499;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 116px;
        y: 0px;
        width: parent.width - 116px;
        height: parent.height;
        text: root.value;
        color: #e7e9e8;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component TreeHeader inherits Rectangle {
    height: 33px;
    background: #191c1f;
    border-color: #303438;
    border-width: 1px;

    Text {
        x: 18px;
        width: parent.width - 438px;
        height: parent.height;
        text: "Name";
        color: #9aa0a5;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 420px;
        width: 116px;
        height: parent.height;
        text: "Size";
        color: #9aa0a5;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 292px;
        width: 116px;
        height: parent.height;
        text: "Allocated";
        color: #9aa0a5;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 158px;
        width: 78px;
        height: parent.height;
        text: "Kind";
        color: #9aa0a5;
        font-size: 12px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 78px;
        width: 54px;
        height: parent.height;
        text: "Items";
        color: #9aa0a5;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component TreeEntry inherits Rectangle {
    in property <DisplayRow> entry;
    callback selected(int);
    callback toggled(int);

    height: 30px;
    background: root.entry.selected ? #2f4b40 : touch.has-hover ? #22272a : #171a1c;

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #202427;
    }

    Text {
        x: 16px + root.entry.indent_px * 1px;
        width: 18px;
        height: parent.height;
        text: root.entry.folder ? (root.entry.expanded ? "v" : ">") : "";
        color: #a4abae;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 40px + root.entry.indent_px * 1px;
        width: max(80px, root.width - self.x - 430px);
        height: parent.height;
        text: root.entry.name;
        color: root.entry.selected ? #f4f7f5 : #e6e9e8;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 420px;
        width: 116px;
        height: parent.height;
        text: root.entry.size;
        color: #c4c9c8;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 292px;
        width: 116px;
        height: parent.height;
        text: root.entry.allocated;
        color: #aeb5b5;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 158px;
        width: 78px;
        height: parent.height;
        text: root.entry.kind;
        color: #99a1a3;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: parent.width - 78px;
        width: 54px;
        height: parent.height;
        text: root.entry.children;
        color: #99a1a3;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.selected(root.entry.id);
        }
        double-clicked => {
            if (root.entry.folder) {
                root.toggled(root.entry.id);
            }
        }
    }

    TouchArea {
        x: 8px + root.entry.indent_px * 1px;
        y: 0px;
        width: 34px;
        height: parent.height;
        enabled: root.entry.folder;
        mouse-cursor: pointer;
        clicked => {
            root.toggled(root.entry.id);
        }
    }
}

export component AppWindow inherits Window {
    title: "DiskLoom";
    width: 1180px;
    height: 760px;

    in-out property <string> scan_path;
    in property <[DriveItem]> drives;
    in property <[DisplayRow]> rows;
    in property <string> status_title;
    in property <string> status_detail;
    in property <string> scan_size;
    in property <string> scan_allocated;
    in property <string> scan_entries;
    in property <string> scan_elapsed;
    in property <string> selected_path;
    in property <string> visible_count;
    in property <bool> scanning;
    in-out property <int> scanner_mode;

    callback scan_requested(string);
    callback cancel_requested();
    callback drive_selected(string);
    callback scanner_selected(int);
    callback row_selected(int);
    callback row_toggled(int);

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #151719;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            Rectangle {
                height: 70px;
                background: #171a1c;
                border-color: #303438;
                border-width: 1px;

                Text {
                    x: 24px;
                    y: 0px;
                    width: 160px;
                    height: parent.height;
                    text: "DiskLoom";
                    color: #f2f4f3;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: 165px;
                    y: 24px;
                    width: 1px;
                    height: 22px;
                    background: #454a4f;
                }

                Text {
                    x: 184px;
                    y: 0px;
                    width: parent.width - 208px;
                    height: parent.height;
                    text: "See your disk clearly.";
                    color: #9aa1a5;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: 322px;
                    background: #191c1f;
                    border-color: #303438;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        Text {
                            height: 24px;
                            text: "Scan";
                            color: #f0f2f1;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Text {
                            height: 18px;
                            text: "Path";
                            color: #8f969b;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            background: #111416;
                            border-color: #2a2f33;
                            border-width: 1px;

                            LineEdit {
                                x: 10px;
                                y: 2px;
                                width: parent.width - 20px;
                                height: parent.height - 4px;
                                text <=> root.scan_path;
                                font-size: 13px;
                            }
                        }

                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            Text {
                                width: 52px;
                                text: "Mode";
                                color: #8f969b;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            PillButton {
                                text: "Auto";
                                checked: root.scanner_mode == 0;
                                enabled: !root.scanning;
                                clicked => { root.scanner_selected(0); }
                            }
                            PillButton {
                                text: "NTFS";
                                checked: root.scanner_mode == 1;
                                enabled: !root.scanning;
                                clicked => { root.scanner_selected(1); }
                            }
                            PillButton {
                                text: "Fallback";
                                checked: root.scanner_mode == 2;
                                enabled: !root.scanning;
                                clicked => { root.scanner_selected(2); }
                            }
                        }

                        Text {
                            height: 18px;
                            text: "Drives";
                            color: #8f969b;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            for drive in root.drives: PillButton {
                                text: drive.label;
                                checked: root.scan_path == drive.path;
                                enabled: !root.scanning;
                                clicked => { root.drive_selected(drive.path); }
                            }
                        }

                        HorizontalLayout {
                            height: 40px;
                            spacing: 10px;

                            PillButton {
                                text: "Scan";
                                checked: true;
                                enabled: !root.scanning;
                                clicked => { root.scan_requested(root.scan_path); }
                            }

                            PillButton {
                                text: "Cancel";
                                checked: false;
                                enabled: root.scanning;
                                clicked => { root.cancel_requested(); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #303438;
                        }

                        Text {
                            height: 22px;
                            text: root.status_title;
                            color: #f0f2f1;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            height: 38px;
                            text: root.status_detail;
                            color: #9aa1a5;
                            font-size: 13px;
                            wrap: word-wrap;
                            overflow: elide;
                        }

                        StatLine { label: "Size"; value: root.scan_size; }
                        StatLine { label: "Allocated"; value: root.scan_allocated; }
                        StatLine { label: "Entries"; value: root.scan_entries; }
                        StatLine { label: "Elapsed"; value: root.scan_elapsed; }

                        Rectangle {
                            height: 1px;
                            background: #303438;
                        }

                        Text {
                            height: 18px;
                            text: "Selected";
                            color: #8f969b;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Text {
                            height: 64px;
                            text: root.selected_path;
                            color: #d7dbda;
                            font-size: 12px;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    background: #151719;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            height: 34px;
                            spacing: 12px;

                            Text {
                                text: "Files and folders";
                                color: #f0f2f1;
                                font-size: 18px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Text {
                                width: 270px;
                                text: root.visible_count;
                                color: #8f969b;
                                font-size: 13px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        TreeHeader { }

                        Rectangle {
                            background: #171a1c;
                            border-color: #303438;
                            border-width: 1px;
                            vertical-stretch: 1;

                            ScrollView {
                                width: parent.width;
                                height: parent.height;

                                VerticalLayout {
                                    spacing: 0px;
                                    for row in root.rows: TreeEntry {
                                        entry: row;
                                        selected(id) => { root.row_selected(id); }
                                        toggled(id) => { root.row_toggled(id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
